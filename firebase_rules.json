{
  "rules": {
    // 1. Siswa & Admin bebas membaca data (karena siswa & serverless Vercel butuh membaca data)
    ".read": true,
    
    // 2. KUNCI UTAMA: Hanya "Admin" yang bisa menambah/menghapus data master!
    ".write": "auth != null",
    
    // 3. PENGECUALIAN UNTUK UJIAN BERJALAN: 
    "sessions": {
      ".write": true,
      ".indexOn": ["paketId", "userId_paketId", "status"]
    },
    
    // 4. PENGECUALIAN UNTUK PENDAFTARAN & INDEXING
    "pendaftaran": {
      ".write": true,
      ".indexOn": ["email", "id_paket"]
    },

    // 5. PENGECUALIAN UNTUK LEADERBOARD (Sistem ranking hemat kuota)
    "leaderboard": {
      ".write": true
    },

    // 6. INDEXING UNTUK PAKET UJIAN (Mencegah keborosan kuota saat filtering)
    "paket_ujian": {
      ".indexOn": ["judul", "status"]
    },
    
    // 7. PENGECUALIAN UNTUK STATUS BOT WA (Agar VPS bisa setor QR Code ke web)
    "bot_status": {
      ".write": true
    },
    
    // ==========================================
    // TAMBAHAN AGAR BOT BISA MENDAFTARKAN SISWA
    // ==========================================
    "class_users": {
      ".write": true
    },
    "classes": {
      ".write": true
    },
    "class_indents": {
      ".write": true
    },

    // ==========================================
    // TAMBAHAN UNTUK PDF WATERMARK & MODUL BUKU
    // ==========================================
    "pdf_books": {
      ".write": true
    },
    "pdf_access": {
      ".write": true
    }
  }
}
